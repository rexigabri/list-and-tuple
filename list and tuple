# Create a tuple containing 5 products
products = ("Laptop", "Mobile", "Headphones", "Mouse", "Keyboard")

# Display all products
print("Shopping Cart:", products)

# Display first and last products
print("First Product:", products[0])
print("Last Product:", products[-1])

# Display first 3 products
print("First 3 Products:", products[:3])

# Check product availability
product = input("Enter product to check: ")

if product in products:
    print(product, "is available")
else:
    print(product, "is not available")

# Count occurrences of a product
print("Mobile Count:", products.count("Mobile"))

# Find position of a product
print("Position of Mouse:", products.index("Mouse"))

# Concatenate another tuple
new_products = ("Tablet", "Smart Watch")
updated_cart = products + new_products
print("Updated Cart:", updated_cart)

# Repeat tuple twice
print("Repeated Cart:", products * 2)

# Iterate through the tuple
print("Individual Products:")
for item in products:
    print(item)
