marks = []

# Get marks of 5 students
for i in range(5):
    mark = int(input("Enter student mark: "))
   #append()
    marks.append(mark)

# Display all marks
print("Student Marks:", marks)

# Add a new student's mark
marks.append(int(input("Enter new student mark: ")))
print("After append:", marks)

# Insert a mark at second position
marks.insert(1, int(input("Enter mark to insert: ")))
print("After insert:", marks)

# Remove a particular mark
remove_mark = int(input("Enter mark to remove: "))
marks.remove(remove_mark)
print("After remove:", marks)

# Highest and lowest marks
print("Highest Mark:", max(marks))
print("Lowest Mark:", min(marks))

# Total and average
total = sum(marks)
average = total / len(marks)

print("Total Marks:", total)
print("Average Marks:", average)

# Sort in ascending order
marks.sort()
print("Sorted Marks:", marks)

# Count students scoring above 75
count = 0
for mark in marks:
    if mark > 75:
        count += 1

print("Students scored above 75:", count)

# Display marks greater than or equal to 50
print("Marks greater than or equal to 50:")
for mark in marks:
    if mark >= 50:
        print(mark)

